<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="gradientBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2c2c2c" />
      <stop offset="100%" stop-color="#1a1a1a" />
    </linearGradient>
    <linearGradient id="gradientFigures" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D2724C" />
      <stop offset="100%" stop-color="#E8997A" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  
  <rect width="400" height="300" fill="url(#gradientBg)"/>
  
  <g transform="translate(100, 60)">
    <!-- Corazón con efecto de brillo -->
    <path d="M100 30 C110 10 130 10 130 25 C130 40 110 50 100 60 C90 50 70 40 70 25 C70 10 90 10 100 30 Z" 
          fill="#d35f5f" 
          filter="url(#glow)" />
    
    <!-- Figura adulto 1 -->
    <circle cx="50" cy="40" r="25" fill="url(#gradientFigures)"/>
    <path d="M50 70 L50 140 M30 90 L70 90 M50 140 L30 180 M50 140 L70 180" 
          stroke="url(#gradientFigures)" 
          stroke-width="8" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Figura adulto 2 -->
    <circle cx="150" cy="40" r="25" fill="url(#gradientFigures)"/>
    <path d="M150 70 L150 140 M130 90 L170 90 M150 140 L130 180 M150 140 L170 180" 
          stroke="url(#gradientFigures)" 
          stroke-width="8" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Figura niño -->
    <circle cx="100" cy="80" r="15" fill="url(#gradientFigures)"/>
    <path d="M100 100 L100 140 M85 115 L115 115 M100 140 L85 165 M100 140 L115 165" 
          stroke="url(#gradientFigures)" 
          stroke-width="6" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Efecto de luz alrededor de la familia -->
    <circle cx="100" cy="100" r="90" fill="rgba(210, 114, 76, 0.1)" filter="url(#glow)" />
  </g>
  
  <!-- Texto con gradiente -->
  <text x="200" y="270" font-family="Arial" font-size="20" font-weight="bold" fill="url(#gradientFigures)" text-anchor="middle">Derecho de Familia</text>
</svg>