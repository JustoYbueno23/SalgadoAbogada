<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
  <!-- Fondo con gradiente en los colores principales del sitio -->
  <defs>
    <linearGradient id="bg-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D2724C" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#E8997A" stop-opacity="0.1"/>
    </linearGradient>
    
    <!-- Gradiente para figuras -->
    <linearGradient id="figure-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D2724C"/>
      <stop offset="100%" stop-color="#E8997A"/>
    </linearGradient>
    
    <!-- Filtro de brillo para el elemento principal -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  
  <!-- Fondo con gradiente -->
  <rect width="400" height="300" fill="url(#bg-gradient)" rx="10" ry="10"/>
  
  <!-- Círculo decorativo -->
  <circle cx="200" cy="150" r="120" fill="white" opacity="0.05"/>
  
  <!-- Documento principal -->
  <g filter="url(#glow)">
    <rect x="130" y="70" width="140" height="180" rx="5" ry="5" fill="white" stroke="url(#figure-gradient)" stroke-width="2"/>
    
    <!-- Líneas de texto en el documento -->
    <line x1="150" y1="100" x2="250" y2="100" stroke="#D2724C" stroke-width="2"/>
    <line x1="150" y1="120" x2="250" y2="120" stroke="#E8997A" stroke-width="2"/>
    <line x1="150" y1="140" x2="250" y2="140" stroke="#D2724C" stroke-width="2"/>
    <line x1="150" y1="160" x2="250" y2="160" stroke="#E8997A" stroke-width="2"/>
    <line x1="150" y1="180" x2="250" y2="180" stroke="#D2724C" stroke-width="2"/>
    <line x1="150" y1="200" x2="250" y2="200" stroke="#E8997A" stroke-width="2"/>
    
    <!-- Sello de aprobación -->
    <circle cx="200" cy="230" r="15" fill="url(#figure-gradient)" opacity="0.8"/>
  </g>
  
  <!-- Monedas representando finanzas -->
  <circle cx="100" cy="150" r="20" fill="url(#figure-gradient)" opacity="0.8"/>
  <circle cx="90" cy="170" r="15" fill="url(#figure-gradient)" opacity="0.7"/>
  <circle cx="110" cy="180" r="18" fill="url(#figure-gradient)" opacity="0.6"/>
  
  <!-- Flecha ascendente representando recuperación -->
  <path d="M300,180 L330,130 L360,150 L330,130 L340,110" fill="none" stroke="url(#figure-gradient)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Texto "Insolvencia" -->
  <text x="200" y="50" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="url(#figure-gradient)">Procesos de Insolvencia</text>
</svg>